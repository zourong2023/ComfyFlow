# ComfyFlow — Environment Configuration
# Copy this file to .env and fill in your values.

# ComfyUI server
COMFYUI_URL=http://localhost:8188
COMFYUI_AUTH_USER=
COMFYUI_AUTH_PASS=

# LLM for PromptAgent (optional, OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Web panel
HOST=0.0.0.0
PORT=8500
