# ComfyFlow — Model Configuration Example
# Copy to models.yaml and edit for your setup.

# Qwen-Image checkpoint with shared CLIP/VAE
qwen_image:
  clip_name: "your-clip-model.safetensors"
  clip_type: "qwen_image"
  vae: "your-vae.safetensors"
  checkpoints:
    - name: "your-unet.safetensors"
      alias: "my_model"
      style: "2d_anime"
      prompt_style: "natural_language"
  loras:
    - "your-lora.safetensors"

# SDXL checkpoint with separate VAE
sdxl:
  vae: "sdxl_vae.safetensors"
  checkpoints:
    - name: "your-sdxl-checkpoint.safetensors"
      alias: "my_sdxl"
  controlnet:
    - name: "controlnet.safetensors"
      type: "openpose"
